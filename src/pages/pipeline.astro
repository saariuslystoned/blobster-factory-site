---
import Layout from '../layouts/Layout.astro';
import PipelineMultiplaneStage from '../components/PipelineMultiplaneStage.astro';
---

<Layout
  title="Forge Pipeline — Blobster Factory"
  description="How Blobster Smith and Blobster Sculptor shape OpenClaw agent instructions, sidebar icons, and painted character loops."
>
  <!-- CHAMBER 01: OBSIDIAN MASTHEAD + MULTI-DEPTH FORGE ARTWORK -->
  <div class="chamber-obsidian">
    <section class="route-masthead-section">
      <div class="container">
        <div class="eyebrow-tech">
          <span class="dot"></span> Forge Pipeline
        </div>
        <h1 class="obs-route-title">
          Inside the <em>Blobster Forge.</em>
        </h1>
        <p class="obs-lede" style="margin-bottom:24px;">
          From raw prompt to finished OpenClaw agent: Blobster Smith shapes the workspace instructions and guardrails at the anvil, then sends the shell across the workshop to Blobster Sculptor for paint and motion.
        </p>

        <div data-forge-motion-slot aria-label="Smith and Sculptor Multiplane Claw Forging Stage">
          <PipelineMultiplaneStage />
        </div>
      </div>
    </section>
  </div>

  <!-- 12px BAYER ORDERED DITHER TRANSITION -->
  <div class="bayer-dither-strip" aria-hidden="true"></div>

  <!-- CHAMBER 02: THREE-STEP OVERVIEW & SURFACE PREVIEW -->
  <section class="chamber-workbench">
    <div class="container">
      <section id="spec" class="pipeline-grid" aria-label="Three-stage forge overview">
        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> Step 01</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">Agent Brain &amp; Guardrails</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            Each template defines its behavior in plain Markdown and YAML—scoping the agent to its workspace with explicit tool permissions and zero install-time scripts.
          </p>
        </div>

        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> Step 02</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">Crisp Sidebar Icon</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            Every character starts as a clean vector silhouette with bold gear and silhouette cues so you can spot the right agent immediately in a crowded sidebar.
          </p>
        </div>

        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> Step 03</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">Painted Vinyl &amp; Loops</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            High-detail character renders and looping idle and wave animations are cleanly matted for both dark and light OpenClaw themes without halo edges.
          </p>
        </div>
      </section>

      <section
        id="shells"
        class="qa-contact-sheet"
        data-qa-sheet
        data-bad-sheet="false"
        aria-label="Dark and light surface cutout preview"
      >
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div>
            <h2 style="font-size:1.65rem;margin:0;">Dark &amp; Light Surface Preview</h2>
            <p style="margin:4px 0 0;color:var(--color-muted);font-size:13.5px;">
              Compare clean edges against raw chroma fringe across dark and light backgrounds.
            </p>
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button type="button" class="chip-btn" data-qa-char="blobster-smith" aria-pressed="true">Smith</button>
            <button type="button" class="chip-btn" data-qa-char="blobster-sculptor" aria-pressed="false">Sculptor</button>
            <button type="button" class="chip-btn" data-qa-mode="clean" aria-pressed="true">Clean Cutout</button>
            <button type="button" class="chip-btn" data-qa-mode="bad" aria-pressed="false">Raw Fringe</button>
          </div>
        </div>

        <div class="qa-strips">
          <div>
            <div style="font-size:12px;font-weight:500;color:var(--color-muted);margin-bottom:6px;">
              Dark Surface
            </div>
            <div class="qa-swatch dark">
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface small cutout" width="24" height="24" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface medium cutout" width="64" height="64" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface large cutout" width="112" height="112" />
            </div>
          </div>

          <div>
            <div style="font-size:12px;font-weight:500;color:var(--color-muted);margin-bottom:6px;">
              Light Surface
            </div>
            <div class="qa-swatch light">
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface small cutout" width="24" height="24" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface medium cutout" width="64" height="64" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface large cutout" width="112" height="112" />
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <script is:inline>
    (function () {
      var sheet = document.querySelector('[data-qa-sheet]');
      if (!sheet) return;
      var imgs = sheet.querySelectorAll('[data-qa-img]');

      sheet.querySelectorAll('[data-qa-char]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-qa-char') || 'blobster-smith';
          imgs.forEach(function (img) {
            img.setAttribute('src', '/templates/' + slug + '/cutout-256.png');
          });
          sheet.querySelectorAll('[data-qa-char]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
        });
      });

      sheet.querySelectorAll('[data-qa-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var isBad = btn.getAttribute('data-qa-mode') === 'bad';
          sheet.setAttribute('data-bad-sheet', String(isBad));
          sheet.querySelectorAll('[data-qa-mode]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
        });
      });
    })();
  </script>
</Layout>
