---
import Layout from '../layouts/Layout.astro';
import PipelineMultiplaneStage from '../components/PipelineMultiplaneStage.astro';
---

<Layout
  title="Forge Pipeline & QA Spec Lab — Blobster Factory"
  description="How Blobster Smith and Blobster Sculptor forge script-free CLAW.md brains, 24px vector rigs, and #FF00FF chroma-despilled OpenClaw visual packs."
>
  <!-- CHAMBER 01: OBSIDIAN MASTHEAD + OVERHEAD CHAIN & HOOK MULTIPLANE STAGE -->
  <div class="chamber-obsidian">
    <section class="route-masthead-section">
      <div class="container">
        <div class="eyebrow-tech">
          <span class="dot"></span> ROUTE 03 · COMPILER &amp; MULTIPLANE SPEC LAB
        </div>
        <h1 class="obs-route-title">
          Inside the <em>Blobster Forge.</em>
        </h1>
        <p class="obs-lede" style="margin-bottom:24px;">
          How raw prompts become a ClawHub-ready OpenClaw Agent Template: script-free <code>CLAW.md</code> brain, <code>&lt;20</code>-shape <code>24px</code> sidebar SVG, and <code>#FF00FF</code> despilled 3D vinyl loops carried from Smith's anvil to Sculptor's glazing wheel.
        </p>

        <div data-forge-motion-slot aria-label="Smith and Sculptor Multiplane Claw Forging Stage">
          <PipelineMultiplaneStage />
        </div>
      </div>
    </section>

    <div class="preflight-strip">
      <div class="preflight-badges">
        <span class="pf-tag pf-tag-clean">✓ 3-PLANE DEPTH OCCLUSION</span>
        <span class="pf-tag">C³ CHAIN &amp; PENDULUM HOOK</span>
        <span class="pf-tag">0.00% #FF00FF SPILL</span>
      </div>
      <div>SCRUB TIMELINE OR TOGGLE 3D EXPLODED PLANES</div>
    </div>
  </div>

  <!-- 12px BAYER ORDERED DITHER TRANSITION -->
  <div class="bayer-dither-strip" aria-hidden="true"></div>

  <!-- CHAMBER 02: COMPILER CONTRACT & INTERACTIVE #FF00FF QA CONTACT SHEET -->
  <section class="chamber-workbench">
    <div class="container">
      <section id="spec" class="pipeline-grid" aria-label="Three-stage compiler pipeline">
        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> STAGE 01</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">Brain &amp; Sandbox</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            <code>package.json</code> ships zero lifecycle hooks. <code>CLAW.md</code> binds <code>schemaVersion: 1</code> metadata to <code>SOUL.md</code>, while <code>profiles/openclaw.yml</code> locks <code>workspaceOnly: true</code>, explicit tool allowlists, and 5-field cron schedules.
          </p>
        </div>

        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> STAGE 02</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">24px Sidebar Vector Rig</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            Built on OpenClaw's exact <code>viewBox="-12 -18 144 144"</code> lobster silhouette (<code>BODY</code>, <code>LEFT</code>, <code>RIGHT</code>, eyes at <code>(45,32)</code> &amp; <code>(75,32)</code>) plus 5 custom gear layers capped under 20 shapes so <code>24×24</code> avatars stay unmistakable.
          </p>
        </div>

        <div class="stage-box">
          <div class="eyebrow"><span class="dot"></span> STAGE 03</div>
          <h2 style="font-size:1.65rem;margin:8px 0;">#FF00FF Chroma Compiler</h2>
          <p style="color:var(--color-muted);font-size:14px;margin:0;">
            <code>compile_blobster_pack.py</code> despills a <code>2×2</code> <code>#FF00FF</code> sprite sheet into <code>&lt; 2 MiB</code> looping <code>GIF89a</code> files (<code>disposal=2</code>), rejecting magenta fringe above <code>1.5%</code> or border-frame clipping.
          </p>
        </div>
      </section>

      <section
        id="shells"
        class="qa-contact-sheet"
        data-qa-sheet
        data-bad-sheet="false"
        aria-label="Interactive chroma-key QA contact sheet"
      >
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div>
            <div class="eyebrow"><span class="dot"></span> LIVE QA CONTACT SHEET SIMULATOR</div>
            <h2 style="font-size:1.75rem;margin-top:4px;">Test #FF00FF Fringe &amp; Frame Clipping</h2>
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button type="button" class="chip-btn" data-qa-char="blobster-smith" aria-pressed="true">Smith</button>
            <button type="button" class="chip-btn" data-qa-char="blobster-sculptor" aria-pressed="false">Sculptor</button>
            <button type="button" class="chip-btn" data-qa-mode="clean" aria-pressed="true">Clean Cutout</button>
            <button type="button" class="chip-btn" data-qa-mode="bad" aria-pressed="false">Simulate Bad Sheet</button>
          </div>
        </div>

        <div class="qa-strips">
          <div>
            <div class="mono" style="font-size:11px;color:var(--color-muted);margin-bottom:6px;">
              DARK SURFACE (#0D1117) · 24px · 64px · 112px
            </div>
            <div class="qa-swatch dark">
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface 24px cutout" width="24" height="24" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface 64px cutout" width="64" height="64" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Dark surface 112px cutout" width="112" height="112" />
            </div>
          </div>

          <div>
            <div class="mono" style="font-size:11px;color:var(--color-muted);margin-bottom:6px;">
              LIGHT SURFACE (#F8FAFC) · 24px · 64px · 112px
            </div>
            <div class="qa-swatch light">
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface 24px cutout" width="24" height="24" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface 64px cutout" width="64" height="64" />
              <img class="qa-cutout" data-qa-img src="/templates/blobster-smith/cutout-256.png" alt="Light surface 112px cutout" width="112" height="112" />
            </div>
          </div>
        </div>

        <div class="qa-metrics">
          <div class="qa-metric">
            <div>#FF00FF FRINGE SPILL</div>
            <strong data-metric-fringe style="color:var(--color-clean);">0.42% PASS (&lt; 1.50% max)</strong>
          </div>
          <div class="qa-metric">
            <div>FRAME BORDER CLIPPING</div>
            <strong data-metric-clip style="color:var(--color-clean);">0 border px PASS</strong>
          </div>
          <div class="qa-metric">
            <div>24PX VECTOR SHAPES</div>
            <strong style="color:var(--color-clean);">15 shapes PASS (&lt; 20 max)</strong>
          </div>
        </div>
      </section>

      <div class="emdash-disclosure-stack">
        <details class="emdash-collapse" open>
          <summary>
            <span>Visual Pack Tiers · Tier 1 (Fast Pack) vs. Tier 2 (73-Frame Pet Rig)</span>
            <span class="collapse-meta">Compare asset budgets ▾</span>
          </summary>
          <div class="collapse-body">
            <pre><code>{`Tier 1 — Fast Pack (Default for Focus Week Templates):
  • blobster.svg          256x256 vector (<20 custom shapes, crisp at 24x24)
  • cutout-256.png        Transparent 256x256 RGBA PNG for ClawHub & cards
  • hero-512.png          Collectible 3D vinyl render (512x512 RGBA)
  • blobster-idle.gif     Despilled GIF89a loop (< 2 MiB, disposal=2)
  • blobster-wave.gif     Despilled GIF89a greeting loop (< 2 MiB, disposal=2)

Tier 2 — Full Companion Pet Rig (Optional Graduation):
  • sprite.png            1536x2288 sheet · 16 animation states · 73 frames
  • sprite-manifest.json  Deterministic frame timing & state-machine table`}</code></pre>
          </div>
        </details>

        <details class="emdash-collapse">
          <summary>
            <span>Gateway Integration Roadmap · Static Tarball Edge vs. <code>dinkus-openclaw</code></span>
            <span class="collapse-meta">v1 decoupled architecture ▾</span>
          </summary>
          <div class="collapse-body">
            <pre><code>{`v1 Focus Week Architecture (Active):
  • Canonical Storefront: https://blobsterfactory.com (EmDash CMS + moderated SQLite/D1)
  • Short Tarball Host:   https://blobster.dev/t/<slug>.tgz (SHA-256 verified, script-free)
  • Zero live OpenClaw gateway runtime coupling inside the public storefront Worker

Post-v1 Companion Integration (Deferred):
  • @dinkuskit/openclaw (dinkus-openclaw) pairs approved templates with authenticated gateway workspaces`}</code></pre>
          </div>
        </details>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var sheet = document.querySelector('[data-qa-sheet]');
      if (!sheet) return;
      var imgs = sheet.querySelectorAll('[data-qa-img]');
      var fringeEl = sheet.querySelector('[data-metric-fringe]');
      var clipEl = sheet.querySelector('[data-metric-clip]');

      sheet.querySelectorAll('[data-qa-char]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-qa-char') || 'blobster-smith';
          imgs.forEach(function (img) {
            img.setAttribute('src', '/templates/' + slug + '/cutout-256.png');
          });
          sheet.querySelectorAll('[data-qa-char]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
        });
      });

      sheet.querySelectorAll('[data-qa-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var isBad = btn.getAttribute('data-qa-mode') === 'bad';
          sheet.setAttribute('data-bad-sheet', String(isBad));
          sheet.querySelectorAll('[data-qa-mode]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
          if (fringeEl) {
            fringeEl.textContent = isBad ? '4.85% FAIL (> 1.50% max)' : '0.42% PASS (< 1.50% max)';
            fringeEl.style.color = isBad ? 'var(--color-danger)' : 'var(--color-clean)';
          }
          if (clipEl) {
            clipEl.textContent = isBad ? '19 border px FAIL (claw clipped)' : '0 border px PASS';
            clipEl.style.color = isBad ? 'var(--color-danger)' : 'var(--color-clean)';
          }
        });
      });
    })();
  </script>
</Layout>
