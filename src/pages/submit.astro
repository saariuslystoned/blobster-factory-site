---
import Layout from '../layouts/Layout.astro';
import { TEMPLATE_CATEGORIES } from '../lib/validation';
---

<Layout
  title="Submit a Template — Blobster Factory"
  description="Share an open-source OpenClaw agent template with the Blobster Factory catalog."
>
  <!-- CHAMBER 01: OBSIDIAN MASTHEAD -->
  <div class="chamber-obsidian">
    <section class="route-masthead-section">
      <div class="container" style="max-width:880px;">
        <div class="eyebrow-tech">
          <span class="dot"></span> Community
        </div>
        <h1 class="obs-route-title">
          Submit a <em>Blobster Template.</em>
        </h1>
        <p class="obs-lede">
          Share an OpenClaw agent template with the community. Every submission is reviewed before appearing in the catalog.
        </p>
      </div>
    </section>
  </div>

  <!-- 12px BAYER ORDERED DITHER TRANSITION -->
  <div class="bayer-dither-strip" aria-hidden="true"></div>

  <!-- CHAMBER 02: SUBMISSION FORM -->
  <section class="chamber-workbench">
    <div class="container" style="max-width:880px;">
      <form class="stage-box" data-template-submit-form novalidate>
        <div class="form-grid">
          <div class="field">
            <label for="f-title">Template Name</label>
            <input id="f-title" name="title" type="text" required maxlength="80" placeholder="e.g. Incident Scribe" />
          </div>
          <div class="field">
            <label for="f-coord">Coordinate (@handle/slug)</label>
            <input id="f-coord" name="coordinate" type="text" required placeholder="@handle/incident-scribe" />
          </div>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="f-owner">GitHub / Publisher Handle</label>
            <input id="f-owner" name="owner_handle" type="text" required placeholder="handle" />
          </div>
          <div class="field">
            <label for="f-version">Version</label>
            <input id="f-version" name="version" type="text" required value="0.1.0" />
          </div>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="f-cat">Category</label>
            <select id="f-cat" name="category">
              {TEMPLATE_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-tier">Avatar Pack</label>
            <select id="f-tier" name="avatar_tier">
              <option value="Tier 1 Fast Pack (SVG + 512px Vinyl + 2 GIFs)">
                Standard Pack (SVG + Character Render + GIFs)
              </option>
              <option value="Tier 2 Full Pet Rig (73-frame Sprite + Manifest)">
                Animated Companion Sprite Pack
              </option>
              <option value="24px Vector Blobster SVG Only">Vector Icon Only</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="f-summary">Summary</label>
          <textarea
            id="f-summary"
            name="summary"
            required
            maxlength="400"
            placeholder="What job does this agent perform, and what stays human-approved?"
            style="min-height:78px;font-family:var(--font-sans);"
          ></textarea>
        </div>

        <div class="field">
          <label for="f-claw">CLAW.md</label>
          <textarea
            id="f-claw"
            name="claw_md"
            required
            placeholder={`---\nschemaVersion: 1\nname: Incident Scribe\n---\n\nProduces post-incident timelines without paging or closing tickets.`}
          ></textarea>
        </div>

        <div class="field">
          <label for="f-profile">profiles/openclaw.yml</label>
          <textarea
            id="f-profile"
            name="openclaw_yml"
            required
            placeholder={`profileVersion: 1\nsandbox:\n  workspaceOnly: true`}
            style="min-height:84px;"
          ></textarea>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="f-skill">Bundled Skill Name (Optional)</label>
            <input id="f-skill" name="skill_name" type="text" maxlength="80" placeholder="incident-timeline-ledger" />
          </div>
          <div class="field">
            <label for="f-cron">Schedule</label>
            <input id="f-cron" name="cron_summary" type="text" maxlength="160" value="On-demand" />
          </div>
        </div>

        <div class="field">
          <label for="f-links">Public GitHub / Repository Links (one per line)</label>
          <textarea
            id="f-links"
            name="links"
            required
            placeholder="https://github.com/owner/repo/tree/main/templates/incident-scribe"
            style="min-height:72px;"
          ></textarea>
        </div>

        <div class="sr-only" aria-hidden="true">
          <label for="f-website">Leave empty</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div style="margin:14px 0 18px;display:flex;gap:10px;align-items:flex-start;">
          <input id="f-confirm" name="script_free_confirm" type="checkbox" required style="margin-top:4px;" />
          <label for="f-confirm" style="font-size:13.5px;">
            This template contains no install scripts, symlinks, or embedded credentials.
          </label>
        </div>

        <button type="submit" class="btn btn-primary" data-submit-btn>Submit Template →</button>
        <div class="receipt-banner" data-submit-status style="margin-top:14px;"></div>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.querySelector('[data-template-submit-form]');
      var statusEl = document.querySelector('[data-submit-status]');
      var btn = document.querySelector('[data-submit-btn]');
      if (!form) return;

      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var fd = new FormData(form);
        var linksRaw = String(fd.get('links') || '');
        var payload = {
          title: String(fd.get('title') || ''),
          coordinate: String(fd.get('coordinate') || ''),
          owner_handle: String(fd.get('owner_handle') || ''),
          version: String(fd.get('version') || ''),
          category: String(fd.get('category') || 'Engineering'),
          avatar_tier: String(fd.get('avatar_tier') || 'Tier 1 Fast Pack (SVG + 512px Vinyl + 2 GIFs)'),
          summary: String(fd.get('summary') || ''),
          claw_md: String(fd.get('claw_md') || ''),
          openclaw_yml: String(fd.get('openclaw_yml') || ''),
          skill_name: String(fd.get('skill_name') || ''),
          cron_summary: String(fd.get('cron_summary') || ''),
          links: linksRaw
            .split(/\r?\n/)
            .map(function (s) {
              return s.trim();
            })
            .filter(Boolean),
          script_free_confirm: fd.get('script_free_confirm') === 'on',
          website: String(fd.get('website') || ''),
        };

        if (btn) btn.setAttribute('disabled', 'true');
        fetch('/_emdash/api/plugins/blobster-submissions/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            return r.json();
          })
          .then(function (res) {
            if (btn) btn.removeAttribute('disabled');
            if (!statusEl) return;
            statusEl.setAttribute('data-visible', 'true');
            if (res && res.ok) {
              statusEl.style.borderColor = 'var(--color-clean)';
              statusEl.style.color = 'var(--color-clean)';
              statusEl.textContent = '✓ Submitted for review · Reference: ' + res.reference;
              form.reset();
            } else {
              statusEl.style.borderColor = 'var(--color-danger)';
              statusEl.style.color = 'var(--color-danger)';
              statusEl.textContent = '✕ ' + ((res && res.error) || 'Submission rejected; check field formats.');
            }
          })
          .catch(function () {
            if (btn) btn.removeAttribute('disabled');
            if (statusEl) {
              statusEl.setAttribute('data-visible', 'true');
              statusEl.textContent = '✕ Network error submitting template.';
            }
          });
      });
    })();
  </script>
</Layout>
