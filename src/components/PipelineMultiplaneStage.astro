---
/* Ambient 3-Plane Overhead Chain Hoist & Cast-Iron Hook Multiplane Artwork (/pipeline hero) */
---

<div
  class="mp-frame"
  id="mp-frame"
  role="img"
  aria-label="Blobster Smith hammering a claw at the anvil while an overhead chain hoist and cast-iron hook carry it behind the foreground steel girder to Blobster Sculptor's cyan glazing wheel"
>
  <div class="mp-stage-wrap" id="mp-stage-wrap">
    <div class="mp-shadowbox" id="mp-shadowbox">
      <!-- PLANE 01: Deep Workshop Diorama + Reactive Hearth & Cyan Glaze Blooms -->
      <div class="mp-plane mp-plane-bg" id="plane-bg-wrap">
        <svg viewBox="0 0 1344 768" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
          <defs>
            <radialGradient id="hearth-bloom" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ff922b" stop-opacity="0.9" />
              <stop offset="55%" stop-color="#ff4d00" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#ff4d00" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="cyan-bloom" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#38e8ff" stop-opacity="0.85" />
              <stop offset="60%" stop-color="#0284c7" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
            </radialGradient>
          </defs>
          <image
            href="/pipeline-plates/bg.webp"
            x="-26"
            y="-12"
            width="1396"
            height="792"
            preserveAspectRatio="xMidYMid slice"
          />
          <ellipse id="glow-hearth" cx="262" cy="296" rx="235" ry="165" fill="url(#hearth-bloom)" style="mix-blend-mode:screen" />
          <ellipse id="glow-cyan" cx="1115" cy="290" rx="215" ry="155" fill="url(#cyan-bloom)" style="mix-blend-mode:screen" />
        </svg>
      </div>

      <!-- PLANE 02: Midground Overhead Chain Hoist, Cast-Iron Hook, Smith, Claw & Sculptor -->
      <div class="mp-plane mp-plane-mid" id="plane-mid-wrap">
        <svg viewBox="0 0 1344 768" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
          <defs>
            <clipPath id="behind-slate-bench">
              <rect x="0" y="0" width="1344" height="446" />
            </clipPath>
            <clipPath id="chain-below-pulley">
              <rect x="-60" y="0" width="120" height="340" />
            </clipPath>
            <clipPath id="slack-below-pulley">
              <rect x="-40" y="0" width="80" height="220" />
            </clipPath>
            <linearGradient id="scan-beam-grad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#38e8ff" stop-opacity="0" />
              <stop offset="50%" stop-color="#5eead4" stop-opacity="0.58" />
              <stop offset="100%" stop-color="#38e8ff" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="relic-aura" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffc233" stop-opacity="0.52" />
              <stop offset="55%" stop-color="#e5243b" stop-opacity="0.22" />
              <stop offset="100%" stop-color="#e5243b" stop-opacity="0" />
            </radialGradient>
          </defs>

          <image href="/pipeline-plates/rail.png" x="88" y="88" width="1168" height="10" preserveAspectRatio="none" />

          <g clip-path="url(#behind-slate-bench)">
            <g id="actor-smith">
              <image id="img-smith-rest" href="/pipeline-plates/smith-rest.webp" x="0" y="0" width="258" height="258" />
              <image id="img-smith-up" href="/pipeline-plates/smith-up.webp" x="0" y="0" width="258" height="258" opacity="0" />
            </g>
          </g>

          <g clip-path="url(#behind-slate-bench)">
            <g id="actor-sculptor">
              <image id="img-sculptor-rest" href="/pipeline-plates/sculptor-rest.webp" x="0" y="0" width="258" height="258" />
              <image id="img-sculptor-up" href="/pipeline-plates/sculptor-up.webp" x="0" y="0" width="258" height="258" opacity="0" />
              <image id="img-sculptor-dab" href="/pipeline-plates/sculptor-dab.webp" x="0" y="0" width="258" height="258" opacity="0" />
            </g>
          </g>

          <ellipse id="claw-shadow" cx="236" cy="358" rx="36" ry="7.5" fill="#040609" opacity="0.72" />
          <ellipse id="anvil-shockwave" cx="236" cy="357" rx="20" ry="5" fill="none" stroke="#ffb703" stroke-width="2.8" opacity="0" />
          <ellipse id="relic-halo" cx="1109" cy="322" rx="125" ry="138" fill="url(#relic-aura)" opacity="0" style="mix-blend-mode:screen" />

          <!-- Claw Specimen + 3D Forged Pincer Lifting Bridle -->
          <g id="actor-claw">
            <image id="img-claw-1" href="/pipeline-plates/claw-1.webp" x="0" y="0" width="126" height="192" />
            <image id="img-claw-2" href="/pipeline-plates/claw-2.webp" x="0" y="0" width="126" height="192" opacity="0" />
            <image id="img-claw-3" href="/pipeline-plates/claw-3.webp" x="0" y="0" width="126" height="192" opacity="0" />
            <image id="img-shackle" href="/pipeline-plates/bridle.png" x="39" y="-6" width="58" height="46" />
          </g>

          <!-- Overhead 3D Chain Hoist + Grooved Pulley + Differential Steel Chain + Cast-Iron Hook -->
          <g id="hoist-carriage">
            <g id="hoist-slack-pivot" transform="translate(-16, 62)" clip-path="url(#slack-below-pulley)">
              <image id="img-slack-chain" href="/pipeline-plates/chain-strip.png" x="-5.5" y="-200" width="11" height="240" />
            </g>
            <g id="hoist-load-pendulum" transform="translate(0, 62)">
              <g clip-path="url(#chain-below-pulley)">
                <image id="img-load-chain" href="/pipeline-plates/chain-strip.png" x="-6" y="-240" width="12" height="250" />
              </g>
              <image id="img-hook" href="/pipeline-plates/hook.webp" x="-13.5" y="10" width="28" height="53" />
            </g>
            <image id="img-trolley" href="/pipeline-plates/trolley.webp" x="-31" y="0" width="52" height="76" />
          </g>

          <rect id="gantry-scan-beam" x="653" y="96" width="70" height="410" fill="url(#scan-beam-grad)" opacity="0" style="mix-blend-mode:screen" />
          <g id="fx-layer"></g>
        </svg>
      </div>

      <!-- PLANE 03: Foreground Occlusion Mask (Riveted Steel Gantry, Center Girder, Sill Hammer & Cyan Jar) -->
      <div class="mp-plane mp-plane-fg" id="plane-fg-wrap" style="pointer-events:none">
        <svg viewBox="0 0 1344 768" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
          <image
            href="/pipeline-plates/fg-healed.webp"
            x="-30"
            y="-14"
            width="1404"
            height="796"
            preserveAspectRatio="xMidYMid slice"
          />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .mp-frame {
    position: relative;
    width: 100%;
    background: var(--obs-inset);
    border: 1px solid var(--obs-border-strong);
    border-radius: 6px;
    box-shadow: 0 22px 58px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .mp-stage-wrap {
    position: relative;
    width: 100%;
    background: var(--obs-inset);
    overflow: hidden;
  }
  .mp-shadowbox {
    position: relative;
    width: 100%;
    aspect-ratio: 1344 / 768;
  }
  .mp-plane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    will-change: transform;
  }
</style>

<script is:inline>
  (function () {
    var frameEl = document.getElementById('mp-frame');
    if (!frameEl) return;

    function clamp01(v) {
      return Math.max(0, Math.min(1, v));
    }
    function smooth7(a, b, x) {
      var u = clamp01((x - a) / (b - a));
      var u2 = u * u;
      var u4 = u2 * u2;
      return u4 * (35 - 84 * u + 70 * u2 - 20 * u * u2);
    }
    function smooth3(a, b, x) {
      var u = clamp01((x - a) / (b - a));
      return u * u * (3 - 2 * u);
    }

    var STANDBY_X = 456;
    var ANVIL_HOOK_X = 241;
    var WHEEL_HOOK_X = 1114;

    function getCraneX(t) {
      if (t <= 0.14) return STANDBY_X;
      if (t <= 0.235) return STANDBY_X - smooth7(0.14, 0.235, t) * (STANDBY_X - ANVIL_HOOK_X);
      if (t <= 0.295) return ANVIL_HOOK_X;
      if (t <= 0.665) return ANVIL_HOOK_X + smooth7(0.295, 0.665, t) * (WHEEL_HOOK_X - ANVIL_HOOK_X);
      if (t <= 0.775) return WHEEL_HOOK_X;
      if (t <= 0.965) return WHEEL_HOOK_X - smooth7(0.775, 0.965, t) * (WHEEL_HOOK_X - STANDBY_X);
      return STANDBY_X;
    }

    var PEND_N = 1200;
    var pendTable = new Float32Array(PEND_N);
    (function () {
      var T_SEC = 11.5;
      var dt = T_SEC / PEND_N;
      var theta = 0;
      var omega = 0;
      for (var pass = 0; pass < 3; pass++) {
        for (var i = 0; i < PEND_N; i++) {
          var t = i / PEND_N;
          var tPrev = ((i - 1 + PEND_N) % PEND_N) / PEND_N;
          var tNext = ((i + 1) % PEND_N) / PEND_N;
          var ax = (getCraneX(tNext) - 2 * getCraneX(t) + getCraneX(tPrev)) / (dt * dt);
          var carrying = smooth3(0.25, 0.29, t) * (1 - smooth3(0.65, 0.69, t));
          var wn = carrying > 0.5 ? 6.6 : 9.4;
          var latchDamp = smooth3(0.21, 0.24, t) * (1 - smooth3(0.28, 0.30, t)) * 2.8;
          var landDamp = smooth3(0.61, 0.665, t) * (1 - smooth3(0.70, 0.74, t)) * 3.0;
          var zeta = 0.54 + latchDamp + landDamp;
          var driveScale = carrying > 0.5 ? 0.00027 : 0.0001;
          var alpha = -wn * wn * theta - 2 * zeta * wn * omega + ax * driveScale;
          omega += alpha * dt;
          theta += omega * dt;
          if (pass === 2) pendTable[i] = theta * (180 / Math.PI);
        }
      }
    })();

    function getSwingDeg(t) {
      var f = (((t % 1) + 1) % 1) * PEND_N;
      var i0 = Math.floor(f) % PEND_N;
      var i1 = (i0 + 1) % PEND_N;
      var frac = f - Math.floor(f);
      return pendTable[i0] * (1 - frac) + pendTable[i1] * frac;
    }

    var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var st = {
      t: reducedMotion ? 0.49 : 0,
      playing: !reducedMotion,
      duration: 11.5,
      pointerX: 0,
      pointerY: 0,
    };

    var planeBgWrap = document.getElementById('plane-bg-wrap');
    var planeMidWrap = document.getElementById('plane-mid-wrap');
    var planeFgWrap = document.getElementById('plane-fg-wrap');
    var glowHearth = document.getElementById('glow-hearth');
    var glowCyan = document.getElementById('glow-cyan');
    var actorSmith = document.getElementById('actor-smith');
    var imgSmithRest = document.getElementById('img-smith-rest');
    var imgSmithUp = document.getElementById('img-smith-up');
    var actorSculptor = document.getElementById('actor-sculptor');
    var imgSculptorRest = document.getElementById('img-sculptor-rest');
    var imgSculptorUp = document.getElementById('img-sculptor-up');
    var imgSculptorDab = document.getElementById('img-sculptor-dab');
    var hoistCarriage = document.getElementById('hoist-carriage');
    var imgSlackChain = document.getElementById('img-slack-chain');
    var hoistLoadPendulum = document.getElementById('hoist-load-pendulum');
    var imgLoadChain = document.getElementById('img-load-chain');
    var imgHook = document.getElementById('img-hook');
    var actorClaw = document.getElementById('actor-claw');
    var imgClaw1 = document.getElementById('img-claw-1');
    var imgClaw2 = document.getElementById('img-claw-2');
    var imgClaw3 = document.getElementById('img-claw-3');
    var imgShackle = document.getElementById('img-shackle');
    var clawShadow = document.getElementById('claw-shadow');
    var anvilShockwave = document.getElementById('anvil-shockwave');
    var gantryScanBeam = document.getElementById('gantry-scan-beam');
    var relicHalo = document.getElementById('relic-halo');
    var fxLayer = document.getElementById('fx-layer');
    var stageWrap = document.getElementById('mp-stage-wrap');

    stageWrap.addEventListener('pointermove', function (e) {
      var r = stageWrap.getBoundingClientRect();
      st.pointerX = ((e.clientX - r.left) / r.width - 0.5) * 2;
      st.pointerY = ((e.clientY - r.top) / r.height - 0.5) * 2;
      if (!st.playing) render();
    });
    stageWrap.addEventListener('pointerleave', function () {
      st.pointerX = 0;
      st.pointerY = 0;
      if (!st.playing) render();
    });

    var CARRIAGE_Y = 58;
    var PIVOT_Y = CARRIAGE_Y + 62;
    var HOOK_SADDLE_OFFSET = 35.0;
    var RING_DX = 68.0;
    var RING_DY = 3.0;
    var CLAW_FOOT_DY = 184.5;
    var ANVIL_FOOT_Y = 359.0;
    var WHEEL_FOOT_Y = 408.0;
    var CHAIN_STANDBY = 16.0;
    var CHAIN_LATCH = 22.5;
    var CHAIN_LIFT = 4.5;
    var CHAIN_LAND = 71.5;

    function render() {
      var t = ((st.t % 1) + 1) % 1;

      var camPan = Math.sin((t - 0.5) * Math.PI);
      planeBgWrap.style.transform =
        'translate3d(' + (-camPan * 10 - st.pointerX * 9).toFixed(2) + 'px, ' + (-st.pointerY * 5).toFixed(2) + 'px, 0)';
      planeMidWrap.style.transform = 'translate3d(' + (-camPan * 2 + st.pointerX * 3).toFixed(2) + 'px, 0px, 0)';
      planeFgWrap.style.transform =
        'translate3d(' + (camPan * 16 + st.pointerX * 15).toFixed(2) + 'px, ' + (st.pointerY * 7).toFixed(2) + 'px, 0)';

      var forgeEnv = smooth3(0.01, 0.028, t) * (1 - smooth3(0.16, 0.195, t));
      var hammerCycle = ((t - 0.01) / 0.052) % 1;
      var isWindup = forgeEnv > 0.25 && hammerCycle >= 0 && hammerCycle < 0.55;
      var impactPulse = forgeEnv * Math.exp(-Math.pow((hammerCycle - 0.65) / 0.11, 2));

      imgSmithUp.setAttribute('opacity', isWindup ? '1' : '0');
      imgSmithRest.setAttribute('opacity', isWindup ? '0' : '1');
      var smithY = 212 - (isWindup ? Math.sin((hammerCycle / 0.55) * Math.PI) * 9 : -impactPulse * 6);
      var smithRot = isWindup ? -5.5 * Math.sin((hammerCycle / 0.55) * Math.PI) : impactPulse * 7.0;
      actorSmith.setAttribute(
        'transform',
        'translate(518, ' + smithY.toFixed(1) + ') scale(-1, 1) rotate(' + smithRot.toFixed(2) + ', 129, 170)',
      );

      glowHearth.setAttribute('opacity', (0.48 + 0.46 * impactPulse + 0.1 * Math.sin(t * Math.PI * 10)).toFixed(3));
      if (impactPulse > 0.18) {
        anvilShockwave.setAttribute('opacity', (impactPulse * 0.88).toFixed(2));
        anvilShockwave.setAttribute('rx', (20 + (1 - impactPulse) * 40).toFixed(1));
        anvilShockwave.setAttribute('ry', (4.5 + (1 - impactPulse) * 9).toFixed(1));
      } else {
        anvilShockwave.setAttribute('opacity', '0');
      }

      var craneX = getCraneX(t);
      var swingDeg = getSwingDeg(t);

      var chainLen = CHAIN_STANDBY;
      if (t < 0.17) {
        chainLen = CHAIN_STANDBY;
      } else if (t < 0.245) {
        chainLen = CHAIN_STANDBY + smooth7(0.17, 0.245, t) * (CHAIN_LATCH - CHAIN_STANDBY);
      } else if (t < 0.315) {
        chainLen = CHAIN_LATCH - smooth7(0.245, 0.315, t) * (CHAIN_LATCH - CHAIN_LIFT);
      } else if (t < 0.675) {
        chainLen = CHAIN_LIFT + smooth7(0.36, 0.675, t) * (CHAIN_LAND - CHAIN_LIFT);
      } else if (t < 0.705) {
        chainLen = CHAIN_LAND + Math.sin(((t - 0.675) / 0.03) * Math.PI) * 6.0;
      } else if (t < 0.79) {
        chainLen = CHAIN_LAND - smooth7(0.705, 0.79, t) * (CHAIN_LAND - CHAIN_STANDBY);
      } else {
        chainLen = CHAIN_STANDBY;
      }

      hoistCarriage.setAttribute('transform', 'translate(' + craneX.toFixed(2) + ', ' + CARRIAGE_Y + ')');
      var slackLen = 58 - 0.46 * chainLen;
      imgSlackChain.setAttribute('y', (slackLen - 240).toFixed(2));

      hoistLoadPendulum.setAttribute('transform', 'translate(0, 62) rotate(' + swingDeg.toFixed(2) + ')');
      imgLoadChain.setAttribute('y', (chainLen - 250).toFixed(2));
      imgHook.setAttribute('y', (chainLen - 2).toFixed(2));

      var hooked = t >= 0.245 && t <= 0.675;
      var saddleDist = chainLen + HOOK_SADDLE_OFFSET;
      var clawOriginX;
      var clawOriginY;
      var clawRot = 0;
      var clawOp = 1;

      if (t < 0.245) {
        var squashY = 1 - impactPulse * 0.055;
        clawOriginX = ANVIL_HOOK_X - RING_DX;
        clawOriginY = ANVIL_FOOT_Y - CLAW_FOOT_DY * squashY;
        clawOp = smooth3(0.0, 0.022, t);
      } else if (hooked) {
        var rad = swingDeg * (Math.PI / 180);
        var saddleWorldX = craneX - saddleDist * Math.sin(rad);
        var saddleWorldY = PIVOT_Y + saddleDist * Math.cos(rad);
        clawRot = swingDeg * 0.94;
        clawOriginX = saddleWorldX - RING_DX;
        clawOriginY = saddleWorldY - RING_DY;
      } else {
        clawOriginX = WHEEL_HOOK_X - RING_DX;
        clawOriginY = WHEEL_FOOT_Y - CLAW_FOOT_DY;
        clawOp = 1 - smooth3(0.968, 0.998, t);
      }

      var squashScaleY = t < 0.245 ? (1 - impactPulse * 0.055).toFixed(3) : '1';
      var squashScaleX = t < 0.245 ? (1 + impactPulse * 0.04).toFixed(3) : '1';
      actorClaw.setAttribute(
        'transform',
        'translate(' +
          clawOriginX.toFixed(2) +
          ', ' +
          clawOriginY.toFixed(2) +
          ') rotate(' +
          clawRot.toFixed(2) +
          ', ' +
          RING_DX +
          ', ' +
          RING_DY +
          ') scale(' +
          squashScaleX +
          ', ' +
          squashScaleY +
          ')',
      );
      actorClaw.setAttribute('opacity', clawOp.toFixed(3));

      var shackleOp = smooth3(0.14, 0.18, t) * (1 - smooth3(0.685, 0.73, t));
      imgShackle.setAttribute('opacity', shackleOp.toFixed(3));

      var op1 = 1 - smooth3(0.44, 0.53, t);
      var op2 = smooth3(0.42, 0.51, t) * (1 - smooth3(0.76, 0.88, t));
      var op3 = smooth3(0.74, 0.87, t);
      imgClaw1.setAttribute('opacity', op1.toFixed(3));
      imgClaw2.setAttribute('opacity', op2.toFixed(3));
      imgClaw3.setAttribute('opacity', op3.toFixed(3));

      var rotRad = clawRot * (Math.PI / 180);
      var clawFootWorldX = clawOriginX + RING_DX - (CLAW_FOOT_DY - RING_DY) * Math.sin(rotRad) - 5;
      var clawFootWorldY = clawOriginY + RING_DY + (CLAW_FOOT_DY - RING_DY) * Math.cos(rotRad);
      var surfaceY = 492;
      if (clawFootWorldX < 355) {
        surfaceY = ANVIL_FOOT_Y + smooth3(285, 355, clawFootWorldX) * (492 - ANVIL_FOOT_Y);
      } else if (clawFootWorldX > 985) {
        surfaceY = 492 - smooth3(985, 1050, clawFootWorldX) * (492 - WHEEL_FOOT_Y);
      }
      var airGap = Math.max(0, surfaceY - clawFootWorldY);
      var shadowScale = Math.max(0.42, 1 - airGap / 240);
      var shadowOp = (0.72 * Math.max(0.2, 1 - airGap / 200) * clawOp).toFixed(2);
      clawShadow.setAttribute('cx', clawFootWorldX.toFixed(1));
      clawShadow.setAttribute('cy', (surfaceY + 1).toFixed(1));
      clawShadow.setAttribute('rx', (36 * shadowScale).toFixed(1));
      clawShadow.setAttribute('ry', (7.5 * shadowScale).toFixed(1));
      clawShadow.setAttribute('opacity', shadowOp);

      var glazeEnv = smooth3(0.705, 0.745, t) * (1 - smooth3(0.88, 0.92, t));
      var brushCycle = ((t - 0.71) / 0.055) % 1;
      var upOp = 0;
      var dabOp = 0;
      var restOp = 1;
      if (glazeEnv > 0.25 && brushCycle >= 0) {
        if (brushCycle < 0.45) {
          upOp = 1;
          restOp = 0;
        } else if (brushCycle < 0.82) {
          dabOp = 1;
          restOp = 0;
        }
      }
      imgSculptorUp.setAttribute('opacity', String(upOp));
      imgSculptorDab.setAttribute('opacity', String(dabOp));
      imgSculptorRest.setAttribute('opacity', String(restOp));

      var sculpLean = glazeEnv * Math.sin(t * Math.PI * 28) * 5.0;
      var sculpBob = Math.sin(t * Math.PI * 8) * 2.2 - glazeEnv * Math.abs(Math.sin(t * Math.PI * 14)) * 4.5;
      actorSculptor.setAttribute(
        'transform',
        'translate(' + (820 + glazeEnv * 12).toFixed(1) + ', ' + (216 + sculpBob).toFixed(1) + ') rotate(' + sculpLean.toFixed(2) + ', 129, 168)',
      );

      glowCyan.setAttribute('opacity', (0.42 + 0.48 * glazeEnv + 0.25 * smooth3(0.88, 0.95, t)).toFixed(3));

      var scanActive = Math.exp(-Math.pow((t - 0.482) / 0.048, 2));
      gantryScanBeam.setAttribute('opacity', (scanActive * 0.78).toFixed(3));

      var sealActive = smooth3(0.87, 0.91, t) * clawOp;
      relicHalo.setAttribute('opacity', (sealActive * (0.65 + 0.22 * Math.sin(t * Math.PI * 12))).toFixed(3));

      var fx = '';
      if (impactPulse > 0.12) {
        for (var s = 0; s < 12; s++) {
          var ang = -2.85 + (s / 11) * 2.55;
          var dist = 16 + (1 - impactPulse * 0.4) * (32 + (s % 4) * 18);
          var sx = (238 + Math.cos(ang) * dist).toFixed(1);
          var sy = (302 + Math.sin(ang) * dist).toFixed(1);
          var sx2 = (238 + Math.cos(ang) * (dist + 10)).toFixed(1);
          var sy2 = (302 + Math.sin(ang) * (dist + 10)).toFixed(1);
          fx +=
            '<line x1="' +
            sx +
            '" y1="' +
            sy +
            '" x2="' +
            sx2 +
            '" y2="' +
            sy2 +
            '" stroke="' +
            (s % 2 ? '#ffd166' : '#ff6b1a') +
            '" stroke-width="2.8" stroke-linecap="round" opacity="' +
            (impactPulse * 0.95).toFixed(2) +
            '"/>';
        }
      }
      var latchGlint = Math.exp(-Math.pow((t - 0.246) / 0.013, 2));
      if (latchGlint > 0.1) {
        var gs = (0.55 + 0.55 * latchGlint).toFixed(2);
        fx +=
          '<g transform="translate(241, 177.5) scale(' +
          gs +
          ')" opacity="' +
          latchGlint.toFixed(2) +
          '"><path d="M0,-12 L2.8,-2.8 L12,0 L2.8,2.8 L0,12 L-2.8,2.8 L-12,0 L-2.8,-2.8 Z" fill="#ffd166"/></g>';
      }
      if (glazeEnv > 0.12) {
        for (var g = 0; g < 10; g++) {
          var ph = t * Math.PI * 10 + g * 0.72;
          var gr = 38 + (g % 3) * 14;
          var gx = (1109 + Math.cos(ph) * gr).toFixed(1);
          var gy = (318 + Math.sin(ph * 1.2) * 36 - g * 2.5).toFixed(1);
          fx +=
            '<circle cx="' +
            gx +
            '" cy="' +
            gy +
            '" r="' +
            (2.2 + (g % 3) * 1.2).toFixed(1) +
            '" fill="' +
            (g % 3 === 0 ? '#ffffff' : '#38e8ff') +
            '" opacity="' +
            (glazeEnv * 0.85).toFixed(2) +
            '"/>';
        }
        fx +=
          '<ellipse cx="1109" cy="340" rx="56" ry="16" fill="none" stroke="#38e8ff" stroke-width="2.2" stroke-dasharray="24 15" stroke-dashoffset="' +
          (-t * 360).toFixed(0) +
          '" opacity="' +
          (glazeEnv * 0.7).toFixed(2) +
          '"/>';
      }
      if (sealActive > 0.2) {
        var gScale = (0.75 + 0.35 * Math.sin(t * Math.PI * 16)).toFixed(2);
        fx +=
          '<g transform="translate(1138, 232) scale(' +
          gScale +
          ')" opacity="' +
          sealActive.toFixed(2) +
          '"><path d="M0,-13 L3.2,-3.2 L13,0 L3.2,3.2 L0,13 L-3.2,3.2 L-13,0 L-3.2,-3.2 Z" fill="#fff3b0"/></g>';
      }
      fxLayer.innerHTML = fx;
    }

    var rafId = 0;
    var lastTs = performance.now();
    function tick(now) {
      if (!st.playing) return;
      var dt = Math.min(0.05, Math.max(0, (now - lastTs) / 1000));
      lastTs = now;
      st.t = (st.t + dt / st.duration) % 1;
      render();
      rafId = requestAnimationFrame(tick);
    }

    window.__setMotionTime = function (tNorm) {
      st.playing = false;
      cancelAnimationFrame(rafId);
      st.t = clamp01(+tNorm || 0);
      render();
    };

    render();
    if (st.playing) {
      lastTs = performance.now();
      rafId = requestAnimationFrame(tick);
    }
  })();
</script>
